{% extends "base.html" %}
{% block content %}
<style>
    .container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
    .page-header { margin-bottom: 30px; }
    .page-header h1 { font-size: 32px; color: #fff; margin-bottom: 8px; }
    .page-header p { color: #94a3b8; font-size: 14px; }
    
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 25px; }
    .card {
        background: #111827; border: 1px solid #1f2937; border-radius: 12px;
        padding: 25px; display: flex; flex-direction: column; justify-content: space-between;
        transition: transform 0.2s, border-color 0.2s;
    }
    .card:hover { transform: translateY(-4px); border-color: #00d2ff; }
    .badge {
        display: inline-block; background: rgba(0, 210, 255, 0.1); color: #00d2ff;
        font-size: 12px; padding: 5px 12px; border-radius: 20px; margin-bottom: 15px; width: fit-content; font-weight: 600;
    }
    .card h3 { color: #fff; font-size: 19px; margin-bottom: 10px; }
    .card p { color: #94a3b8; font-size: 13px; line-height: 1.6; margin-bottom: 15px; }
    .flavor-tag { font-size: 12px; color: #38bdf8; margin-bottom: 20px; font-weight: 500; }
    .price-row { display: flex; justify-content: space-between; align-items: center; margin-top: auto; border-top: 1px solid #1f2937; padding-top: 15px; }
    .price { font-size: 20px; font-weight: bold; color: #fff; }
    .buy-btn {
        background: #00d2ff; color: #0b0f19; border: none; padding: 9px 18px;
        border-radius: 6px; font-weight: 700; cursor: pointer; transition: background 0.2s;
    }
    .buy-btn:hover { background: #38bdf8; }
</style>

<div class="container">
    <div class="page-header">
        <h1>Volledige Productcatalogus</h1>
        <p>Een overzicht van alle beschikbare wegwerp vapes, pods en e-liquids in ons assortiment.</p>
    </div>

    <div class="grid">
        {% for product in producten %}
        <div class="card">
            <div>
                <span class="badge">{{ product.merk }}</span>
                <h3>{{ product.naam }}</h3>
                <p>{{ product.beschrijving }}</p>
                <div class="flavor-tag">Standaard Smaak: {{ product.smaak }}</div>
            </div>
            <div class="price-row">
                <span class="price">€ {{ "%.2f"|format(product.prijs) }}</span>
                <button class="buy-btn" onclick="alert('{{ product.naam }} toegevoegd aan de aanvraaglijst!')">Bestellen</button>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}