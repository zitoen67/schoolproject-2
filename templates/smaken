{% extends "base.html" %}
{% block content %}
<style>
    .container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
    .page-header { margin-bottom: 30px; }
    .page-header h1 { font-size: 32px; color: #fff; margin-bottom: 8px; }
    .page-header p { color: #94a3b8; font-size: 14px; }

    .flavor-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
    .flavor-card {
        background: #111827; border: 1px solid #1f2937; border-radius: 10px;
        padding: 20px; display: flex; flex-direction: column; justify-content: space-between;
    }
    .flavor-card h3 { color: #fff; font-size: 16px; margin-bottom: 8px; }
    .flavor-meta { display: flex; justify-content: space-between; font-size: 12px; color: #94a3b8; margin-top: 15px; }
    .cat-badge { background: rgba(255,255,255,0.05); padding: 3px 8px; border-radius: 4px; color: #cbd5e1; }
</style>

<div class="container">
    <div class="page-header">
        <h1>Smaken Bibliotheek</h1>
        <p>Ontdek de verschillende smaakprofielen die beschikbaar zijn in onze lijn van e-liquids en wegwerp vapes.</p>
    </div>

    <div class="flavor-grid">
        {% for smaak in smaken %}
        <div class="flavor-card">
            <div>
                <h3>{{ smaak.naam }}</h3>
            </div>
            <div class="flavor-meta">
                <span class="cat-badge">{{ smaak.categorie }}</span>
                <span style="color: #38bdf8;">Sterkte: {{ smaak.sterkte }}</span>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}